    {
      "id": "caocao_navy_207",
      "title": "曹操凿玄武池练水军",
      "title_en": "Cao Cao Drills Navy at Xuanwu Pool",
      "year": 207,
      "month": 11,
      "category": "political",
      "description": "曹操在邺城凿玄武池训练水军，为南征做准备。然北人不习水性，训练效果有限。荀彧、程昱等谏言：「水战非我所长，宜先固荆襄，以陆制水。」曹操虽纳其言而意不在此——北军水战之短，终成赤壁之患。",
      "description_en": "Cao Cao excavates Xuanwu Pool at Ye to train northern troops in naval warfare for the southern campaign. However, northern soldiers struggle with water combat — training yields limited results. Xun Yu and Cheng Yu advise: 'Naval warfare is not our strength. Secure Jingzhou first; use land power to neutralize their navy.' Cao Cao acknowledges but remains focused on speed over preparation — a flaw that will cost him at Red Cliffs.",
      "participants": [
        "caocao",
        "xunyu",
        "chengyu"
      ],
      "gravity": 0.6,
      "preconditions": {
        "yuan_extinguished": true,
        "caocao_controls_ye": true
      },
      "outcomes": [
        {
          "id": "navy_trained",
          "description": "北方水军初步成军，但战力远逊江东",
          "description_en": "Northern navy takes shape but remains far inferior to Jiangdong's",
          "effects": {
            "caocao_navy_skill": 30,
            "caocao_naval_readiness": "novice"
          }
        }
      ],
      "butterfly_effects": {
        "triggered": [
          "liubiao_death_208"
        ],
        "if_averted": "若听取荀彧之言延缓南征、加强水军训练，赤壁或可免败"
      },
      "source": "三國志·魏書·武帝紀"
    },
