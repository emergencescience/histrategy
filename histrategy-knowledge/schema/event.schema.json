{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Historical Event",
  "type": "object",
  "required": ["id", "title", "year", "category", "description"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z_]+$"},
    "title": {"type": "string"},
    "year": {"type": "integer", "minimum": 184, "maximum": 280},
    "month": {"type": "integer", "minimum": 1, "maximum": 12},
    "category": {"type": "string", "enum": ["major_battle", "character_death", "diplomatic", "political", "natural_disaster", "birth", "territory_change", "rebellion"]},
    "description": {"type": "string", "maxLength": 500},
    "participants": {"type": "array", "items": {"type": "string"}},
    "gravity": {"type": "number", "minimum": 0.0, "maximum": 1.0, "default": 0.7},
    "preconditions": {"type": "object"},
    "outcomes": {"type": "array", "items": {"type": "object"}},
    "butterfly_effects": {"type": "object"},
    "source": {"type": "string", "description": "Historical source reference"}
  }
}
